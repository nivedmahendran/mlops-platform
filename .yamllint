extends: default

rules:
  line-length:
    max: 160
  truthy:
    # GitHub Actions and Kubernetes both use the bare `on` key, which default
    # yamllint treats as a truthy value and flags.
    allowed-values: ["true", "false", "on"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  document-start: disable
